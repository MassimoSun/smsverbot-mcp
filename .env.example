# SQLite database path (WAL mode is enabled automatically).
MCP_DB=./mcp.db

# Optional default API key for stdio clients. Used when a tool receives api_key="".
MCP_API_KEY=

# Provider adapter: mock (offline, deterministic) or fivesim (real network calls).
PROVIDER=mock

# 5sim API token. Required only when PROVIDER=fivesim. Never commit the real value.
FIVESIM_TOKEN=

# Retail markup over provider cost. Price = max(cost * markup, cost + 1000 kopecks),
# rounded up to the next 100 kopecks.
MCP_MARKUP=2.5

# Maximum buy requests per API key in a sliding 15-minute window.
RATE_LIMIT_PER_15MIN=20

# Maximum non-cancelled orders per API key per UTC day.
DAILY_CODE_LIMIT=200

# How long wait_for_code polls the provider for an SMS code.
CODE_WAIT_SECONDS=120

# USD to RUB conversion rate for provider prices, in kopecks per USD.
USD_KOP_RATE=9200

# Optional defaults for HTTP transport.
# HOST=127.0.0.1
# PORT=8765
