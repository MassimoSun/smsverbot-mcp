[Unit]
Description=Smsverbot MCP server (streamable HTTP, /mcp)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/opt/smsverbot-mcp
EnvironmentFile=/opt/smsverbot-mcp/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/smsverbot-mcp/.venv/bin/python server.py --http --port 8765
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/smsverbot-mcp

[Install]
WantedBy=multi-user.target
